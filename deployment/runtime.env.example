# AutoBuddy runtime configuration. Copy to deployment/runtime.env (gitignored)
# and edit for the host. Do not commit real values.
#
# Compose reads this file for web, worker, migrate and caddy via
# RUNTIME_ENV_FILE. Container-only paths are used here (not host paths).

# --- Public identity -------------------------------------------------------
# Must match the DNS name pointed at this host; Caddy issues its certificate
# for this name.
APP_DOMAIN=portal.example.com
# Include 127.0.0.1 for the container and updater health probes, which connect
# to the loopback listener before Django's health view runs.
ALLOWED_HOSTS=portal.example.com,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://portal.example.com

# --- Database --------------------------------------------------------------
# The password itself is a secret file mounted at /run/secrets/db_password.
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=autobuddy
DATABASE_USER=autobuddy

# Must match the POSTGRES_* values used to initialise the db volume. Changing
# these after first start does NOT rename the database/user.
POSTGRES_DB=autobuddy
POSTGRES_USER=autobuddy

# --- Application -----------------------------------------------------------
TIME_ZONE=Asia/Shanghai
DJANGO_DEBUG=false
# Plain HTTP is opt-in and off by default. Set to 1 only for a deployment
# intentionally served through a controlled reverse proxy as http://IP:PORT
# without TLS. It disables the HTTPS redirect, Secure cookies and HSTS, so the
# administrator password and session cookie travel in cleartext; it does not
# reconfigure Caddy or publish the app port. Prefer HTTPS. DJANGO_DEBUG must
# stay false either way; debug mode is never a substitute for this switch.
# See deployment/README.md for the proxy, ALLOWED_HOSTS and CSRF origin setup.
AUTOBUDDY_ALLOW_HTTP=0
# Disabled by default. Only for a short-lived SSH-tunnel/loopback first setup.
# A future Unix deadline must be no more than 1800 seconds away.
INITIAL_SETUP_DEADLINE=0
APP_VERSION=development

# The worker writes decrypted sign-in sessions only below this tmpfs.
AUTH_TEMP_ROOT=/run/auto-buddy
WORKBUDDY_SCRIPT=/app/workbuddy-auto-signin/signin.py

# --- Gunicorn (web role) ---------------------------------------------------
GUNICORN_WORKERS=3
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60
GUNICORN_GRACEFUL_TIMEOUT=30
# Orchestrators should stop web with at least this grace period. Caddy uses 30s.
# worker uses stop_grace_period 650s because runworker may finish a Run for up to
# WORKER_MAX_SECONDS (600s) after SIGTERM.
