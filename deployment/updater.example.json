{
  "repository": "OWNER/auto-buddy",
  "image_repository": "ghcr.io/owner/auto-buddy",
  "project_directory": "/opt/auto-buddy",
  "compose_file": "/opt/auto-buddy/compose.yaml",
  "project_name": "auto-buddy",
  "runtime_env_file": "/etc/auto-buddy/runtime.env",
  "secrets_dir": "/etc/auto-buddy/secrets",
  "state_dir": "/var/lib/auto-buddy/updater",
  "backup_dir": "/var/backups/auto-buddy",
  "cosign_identity_regexp": "^https://github\\.com/OWNER/auto-buddy/\\.github/workflows/release\\.yml@refs/heads/main$",
  "cosign_identity_subject_regexp": "^https://github\\.com/OWNER/auto-buddy/\\.github/workflows/release\\.yml@refs/heads/main$",
  "cosign_issuer": "https://token.actions.githubusercontent.com",
  "health_url": "http://127.0.0.1:8080/health/",
  "health_retries": 30,
  "health_interval_seconds": 2.0,
  "drain_seconds": 650,
  "drain_poll_seconds": 5.0,
  "stop_web_grace_seconds": 30,
  "stop_worker_grace_seconds": 650,
  "backup_min_tables": 5,
  "backup_retention": 5,
  "release_asset": "release-manifest.json",
  "require_asset_digest": true,
  "github_api_url": "https://api.github.com",
  "docker_bin": "docker",
  "cosign_bin": "cosign",
  "command_timeout_seconds": 900
}
