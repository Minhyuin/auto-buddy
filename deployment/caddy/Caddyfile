{
	# Keep the admin API off: configuration is file-based and Caddy's container
	# filesystem is read-only. Use `docker compose restart caddy` to reload.
	admin off

	# Deliberately no access log: request paths can contain credential ids.
	# Caddy still writes runtime errors to stderr, which Docker captures.
}

# Shared response hardening. Django also sets HSTS via SecurityMiddleware; the
# header handler here replaces it so Caddy-generated errors (502/504) carry the
# same headers as proxied responses.
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
		-X-Powered-By
	}
}

# Public site. Caddy obtains and renews the certificate automatically.
{$APP_DOMAIN:localhost} {
	import security_headers
	encode zstd gzip

	# Django runs with memory-only upload handlers (70 KB/file) and a 64 KB
	# form limit. Reject oversized bodies at the edge; Caddy streams request
	# bodies through memory and never writes them to disk.
	request_body {
		max_size 96KB
	}

	reverse_proxy web:8000 {
		# Django trusts this header (SECURE_PROXY_SSL_HEADER) and redirects
		# plain HTTP to HTTPS. Caddy terminates TLS; never pass the client
		# value through unchanged.
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		header_up X-Real-IP {remote_host}

		# Stream responses as they are produced instead of buffering whole
		# pages; Caddy's request path is in-memory and bounded by request_body.
		flush_interval -1

		health_uri /health/
		health_interval 15s
		health_timeout 5s
		# Active checks otherwise use the upstream address as Host, which
		# Django's ALLOWED_HOSTS rejects. Probe with the public hostname.
		health_headers {
			Host {$APP_DOMAIN}
		}

		transport http {
			dial_timeout 5s
			response_header_timeout 60s
		}
	}
}

# Loopback-only health listener. The compose file publishes this on
# 127.0.0.1:8080 so the host updater can probe the full Caddy -> Django path
# without exposing an extra public port. It forces the forwarded-proto header
# for the same reason as the public site.
:8080 {
	import security_headers

	# Loopback probe endpoint: no application payloads expected.
	request_body {
		max_size 16KB
	}

	reverse_proxy web:8000 {
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		header_up X-Real-IP {remote_host}

		flush_interval -1

		transport http {
			dial_timeout 5s
			response_header_timeout 30s
		}
	}
}
