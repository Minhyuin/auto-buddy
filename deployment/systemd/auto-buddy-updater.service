[Unit]
Description=AutoBuddy verified release updater
Documentation=file:///opt/auto-buddy/deployment/README.md
Wants=network-online.target docker.service
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
Environment=PYTHONUNBUFFERED=1
# ProtectHome hides /root; cosign and Docker need a writable HOME.
Environment=HOME=/var/lib/auto-buddy
ExecStart=/usr/bin/python3 /usr/local/lib/auto-buddy/auto_buddy_updater.py --config /etc/auto-buddy/updater.json
TimeoutStartSec=1800
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/var/lib/auto-buddy /var/backups/auto-buddy

[Install]
WantedBy=multi-user.target
